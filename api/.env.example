# Application
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=50000000
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database
DATABASE_URL=mysql://user:password@localhost:3306/3dpcdb

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=1h

# Stream Chat
STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret

# Seed (only required when running `prisma db seed`)
SEED_ADMIN_PASSWORD=your-admin-password-here
