generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// generator zod {
//   provider = "prisma-zod-generator"
//   output   = "../../client/src/types/zod" // or wherever you want
// }

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(255)
  email          String          @unique(map: "email") @db.VarChar(255)
  password_hash  String          @db.VarChar(255)
  role_id        Int             @default(2)
  grade          grade           @default(other)
  points         Int             @default(0)
  last_active    DateTime?       @db.DateTime(0)
  attendances    attendance[]
  events         event[]
  tasks          task[]
  files          file[]
  role           role            @relation(fields: [role_id], references: [id], onDelete: Cascade)
  activity_logs  activity_log[]
  created_at     DateTime?       @default(now())
  updated_at     DateTime?       @updatedAt
  deleted_at     DateTime?       @db.DateTime(0)
  pointLogs      point_log[]
  recycling_logs recycling_log[]
  error_report   error_report[]
}

model point_log {
  id        Int      @id @default(autoincrement())
  user_id   Int
  change    Int
  reason    String   @db.VarChar(255)
  details   String?  @db.LongText
  logged_at DateTime @default(now()) @db.Timestamp(0)
  user      user     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model activity_log {
  id          Int       @id @default(autoincrement())
  user_id     Int
  action_type String    @db.VarChar(255)
  table_name  String    @db.VarChar(100)
  record_id   Int
  result      String    @db.VarChar(50)
  details     Json?     @db.Json
  created_at  DateTime? @default(now()) @db.DateTime(0)

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model error_report {
  id          Int                 @id @default(autoincrement())
  user_id     Int?
  description String              @db.LongText
  type        error_report_type   @default(bug)
  status      error_report_status @default(open)
  created_at  DateTime?           @default(now())
  updated_at  DateTime?           @updatedAt

  user user? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

enum error_report_type {
  bug
  feature_request
  task_issue
  other
}

enum error_report_status {
  open
  in_progress
  resolved
  closed
}

model attendance {
  id           Int               @id @default(autoincrement())
  user_id      Int
  event_id     Int
  status       attendance_status @default(unknown)
  created_at   DateTime?         @default(now())
  updated_at   DateTime?         @updatedAt
  arrival_time DateTime?         @db.DateTime(0)
  event        event             @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         user              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_id, user_id])
}

model event {
  id                Int                @id @default(autoincrement())
  title             String             @db.VarChar(255)
  description       String             @db.LongText
  location          String             @db.VarChar(255)
  start_time        DateTime           @db.DateTime(0)
  end_time          DateTime           @db.DateTime(0)
  image_file_id     Int?
  is_featured       Boolean?           @default(false)
  event_type        events_event_type? @default(meeting)
  user_id           Int?
  created_at        DateTime?          @default(now())
  updated_at        DateTime?          @updatedAt
  deleted_at        DateTime?          @db.DateTime(0)
  verification_code String             @db.VarChar(255)
  attendances       attendance[]
  image_file        file?              @relation(fields: [image_file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by        user?              @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([start_time, end_time])
  @@unique(verification_code)
}

model file {
  id              Int        @id @default(autoincrement())
  original_name   String     @db.VarChar(255)
  stored_name     String     @db.VarChar(255)
  mime_type       String?    @db.VarChar(100)
  size            Int        @db.UnsignedInt
  path            String     @db.VarChar(255)
  uploaded_by     Int?
  created_at      DateTime?  @default(now())
  updated_at      DateTime?  @updatedAt
  deleted_at      DateTime?  @db.DateTime(0)
  description     String?    @db.Text
  type            file_type  @default(other)
  events          event[]
  models_as_file  model[]    @relation("model_file")
  models_as_image model[]    @relation("model_image_file")
  uploader        user?      @relation(fields: [uploaded_by], references: [id], onDelete: SetNull, onUpdate: Restrict)
  material        material[]
  printer         printer[]
}

// Inventory

model printer {
  id                 Int            @id @default(autoincrement())
  name               String         @db.VarChar(255)
  model              String         @db.VarChar(255)
  image_file_id      Int?
  location           String?        @db.VarChar(255)
  status             printer_status @default(available)
  loaded_material_id Int?
  created_at         DateTime?      @default(now())
  updated_at         DateTime?      @updatedAt

  loaded_material material? @relation(fields: [loaded_material_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  image_file      file?     @relation(fields: [image_file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum printer_status {
  available
  queued
  in_use
  maintenance
  out_of_order
}

model material {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(100)
  type          material_type @default(OTHER)
  description   String?       @db.Text
  image_file_id Int?
  quantity      Int           @db.UnsignedInt
  color         String?       @db.VarChar(50)
  created_at    DateTime?     @default(now())
  updated_at    DateTime?     @updatedAt

  image_file file? @relation(fields: [image_file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  product_template product_template[]
  printer          printer[]
}

model model {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  description   String?   @db.Text
  file_id       Int
  image_file_id Int?
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt

  file             file               @relation(name: "model_file", fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  image_file       file?              @relation(name: "model_image_file", fields: [image_file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_template product_template[]
}

model product_template {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(255)
  description     String?   @db.Text
  model_id        Int
  material_id     Int
  print_settings  String?   @db.Text
  post_processing String?   @db.Text
  created_at      DateTime? @default(now())
  updated_at      DateTime? @updatedAt

  model      model        @relation(fields: [model_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  material   material     @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_item order_item[]
}

enum print_item_source {
  individual
  order_item
}

model order {
  id          Int          @id @default(autoincrement())
  email       String       @db.VarChar(255)
  full_name   String       @db.VarChar(255)
  total_price Decimal      @db.Decimal(10, 2)
  status      String       @db.VarChar(100)
  created_at  DateTime?    @default(now())
  updated_at  DateTime?    @updatedAt
  order_items order_item[]
}

model order_item {
  id                  Int     @id @default(autoincrement())
  order_id            Int
  product_template_id Int
  quantity            Int     @db.UnsignedInt
  price               Decimal @db.Decimal(10, 2)

  order            order            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_template product_template @relation(fields: [product_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model task {
  id             Int         @id @default(autoincrement())
  title          String      @default("New Task") @db.VarChar(255)
  assigned_to    Int?
  scheduled_date DateTime?   @default(now()) @db.DateTime(0)
  type           task_type   @default(other)
  details        Json        @db.Json
  status         task_status @default(pending)

  is_required Boolean   @default(false)
  is_open     Boolean   @default(true)
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt

  assigned_user user? @relation(fields: [assigned_to], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

enum task_type {
  print_job
  maintenance
  inventory_management
  event_preparation
  other
}

enum task_status {
  pending
  in_progress
  completed
  cancelled
  failed
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  version   String @db.VarChar(255)
  class     String @db.VarChar(255)
  group     String @db.VarChar(255)
  namespace String @db.VarChar(255)
  time      Int
  batch     Int    @db.UnsignedInt
}

model role {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?   @db.Text
  created_at  DateTime? @db.DateTime(0)
  updated_at  DateTime? @db.DateTime(0)
  users       user[]
}

model recycling_log {
  id         Int            @id @default(autoincrement())
  type       recycling_type
  amount     Int
  created_at DateTime       @default(now())
  user_id    Int
  created_by user           @relation(fields: [user_id], references: [id])
}

enum recycling_type {
  bottle
  filament_created
  filament_used
}

enum grade {
  freshman
  sophomore
  junior
  senior
  other
}

enum events_event_type {
  meeting
  workshop
  competition
  fundraiser
  work_day
}

enum material_type {
  PLA
  ABS
  PETG
  NYLON
  TPU
  WOODFILL
  METALFILL
  CARBONFIBER
  HIPS
  PVA
  POLYCARBONATE
  RINO
  STANDARD_RESIN
  TOUGH_RESIN
  FLEXIBLE_RESIN
  OTHER
}

enum file_type {
  image
  model
  texture
  document
  other
}

enum attendance_status {
  unknown
  going
  maybe
  not_going
  attended
}
