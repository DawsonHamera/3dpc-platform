# ============================
# Main site
# ============================
deloro3dpc.tech {
    root * /srv
    encode gzip

    @uploads path /api/uploads/*
    handle @uploads {
        reverse_proxy http://localhost:3001 {
            flush_interval -1
        }
    }

    @api path /api/*
    handle @api {
        uri strip_prefix /api
        reverse_proxy http://localhost:3001 {
            flush_interval -1
        }
    }

    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}

# ============================
# WebSocket tunnel site
# ============================
tunnel.deloro3dpc.tech {
    reverse_proxy 127.0.0.1:8080 {
        transport http {
            versions 1.1
        }
    }
}
