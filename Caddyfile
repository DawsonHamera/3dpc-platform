# ============================
# Main site (HTTP + HTTPS)
# ============================
deloro3dpc.tech {
    root * /srv
    encode gzip

    # Static uploads
    @uploads path /api/uploads/*
    handle @uploads {
        reverse_proxy http://localhost:3001 {
            flush_interval -1
        }
    }

    # API endpoints
    @api path /api/*
    handle @api {
        uri strip_prefix /api
        reverse_proxy http://localhost:3001 {
            flush_interval -1
        }
    }

    # WebSocket tunnel endpoint
    @wstunnel path /wstunnel
    handle @wstunnel {
        reverse_proxy 127.0.0.1:8080 {
            transport http {
                versions 1.1
            }
        }
    }

    # SPA fallback
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}

# Optional: redirect HTTP to HTTPS
http://deloro3dpc.tech {
    redir https://deloro3dpc.tech{uri} permanent
}
