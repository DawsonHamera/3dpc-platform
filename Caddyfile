deloro3dpc.tech {
    root * /srv
    encode gzip

    # ============================
    #  API REVERSE PROXY (PRIMARY)
    # ============================
    # Static uploads (no prefix stripping)
    @uploads path /api/uploads/*
    handle @uploads {
        reverse_proxy http://api-prod:3000 {
            flush_interval -1
        }
    }

    # API endpoints - strip /api prefix
    @api path /api/*
    handle @api {
        uri strip_prefix /api
        reverse_proxy http://api-prod:3000 {
            flush_interval -1
        }
    }

    @ultimakers path /ultimakers/*
    handle @ultimakers {
        uri strip_prefix /ultimakers
        reverse_proxy http://host.docker.internal:8081 {
            flush_interval -1
        }
    }

    @ws path /ws /ws/*
    handle @ws {
        uri strip_prefix /ws
        reverse_proxy http://host.docker.internal:8080 {
            flush_interval -1

            # REQUIRED FOR WEBSOCKET
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }


    # ============================
    #  SPA FALLBACK & STATIC FILES
    # ============================
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}

# Optional redirect from non-www to www or vice-versa
www.deloro3dpc.tech {
    redir https://deloro3dpc.tech{uri}
}
