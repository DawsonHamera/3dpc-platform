    email dawsonhamera@gmail.com  # for Let's Encrypt notifications
}

:80 {
    root * /srv
    encode gzip

    # ============================
    #  API REVERSE PROXY (PRIMARY)
    # ============================
    # Static file uploads - don't strip prefix
    @uploads path /api/uploads/*
    handle @uploads {
        reverse_proxy http://api-prod:3000 {
            flush_interval -1
        }
    }

    # API endpoints - strip /api prefix
    @api path /api/*
    handle @api {
        uri strip_prefix /api
        reverse_proxy http://api-prod:3000 {
            flush_interval -1
        }
    }

    # ============================
    # SPA FALLBACK & STATIC FILES
    # ============================
    handle {
        file_server
        try_files {path} {path}/ /index.html
    }
}
